rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerifiedEmail()
        && request.auth.token.email == 'dezzzzzz2007@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (isVerifiedEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidSiteStatus(data) {
      return data.keys().hasAll(['online', 'message', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['online', 'message', 'updatedAt', 'updatedBy'])
        && data.online is bool
        && data.message is string
        && data.message.size() <= 240
        && data.updatedAt is timestamp
        && data.updatedBy is string
        && data.updatedBy.size() >= 1
        && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.token.email;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().hasOnly(['email', 'createdAt'])
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 128
        && data.createdAt is timestamp;
    }

    match /siteStatus/{statusId} {
      allow get: if isValidId(statusId);
      allow list: if false;

      allow create: if isAdmin()
        && isValidId(statusId)
        && isValidSiteStatus(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(statusId)
        && isValidSiteStatus(incoming())
        && (
          isAdmin()
          && incoming().diff(existing()).affectedKeys().hasOnly(['online', 'message', 'updatedAt', 'updatedBy'])
        )
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isBootstrapAdmin());
      allow list: if false;

      allow create: if isBootstrapAdmin()
        && isValidId(adminUid)
        && isValidAdminUser(incoming())
        && incoming().createdAt == request.time;

      allow update: if isBootstrapAdmin()
        && isValidId(adminUid)
        && isValidAdminUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['email'])
        && incoming().createdAt == existing().createdAt;

      allow delete: if isBootstrapAdmin() && isValidId(adminUid);
    }
  }
}
